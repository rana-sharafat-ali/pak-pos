# ==============================================================================
# PakPOS - Environment Configuration Template
# Copy this file to .env and configure with your specific environment settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core Settings
# ------------------------------------------------------------------------------
SECRET_KEY=your-secure-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
TIME_ZONE=Asia/Karachi

# ------------------------------------------------------------------------------
# 2. Email Notifications Configuration
# ------------------------------------------------------------------------------
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here

# ------------------------------------------------------------------------------
# 3. Application Branding & Visual Identity
# ------------------------------------------------------------------------------
APP_NAME=PakPOS
APP_SUBTITLE=Executive Management Portal
APP_CURRENCY=PKR
APP_FOOTER_TEXT=PakPOS — High-Performance Point of Sale System.
APP_PRIMARY_COLOR=#2563eb
PRODUCTS_PER_PAGE=50
SESSION_COOKIE_AGE_DAYS=30

# ------------------------------------------------------------------------------
# 4. Point of Sale (POS) Operating Rules
# ------------------------------------------------------------------------------
POS_DEFAULT_DISCOUNT_PERCENT=0
POS_AUTO_APPLY_DISCOUNT=False
POS_DEFAULT_TAX_PERCENT=0
POS_DEFAULT_SERVICE_CHARGE_PERCENT=0
POS_DEFAULT_DELIVERY_CHARGES=0
POS_OPERATION_MODE=retail
POS_SHIFT_START_HOUR=9
POS_SHIFT_END_HOUR=23

# ------------------------------------------------------------------------------
# 5. Real-Time Cloud Sync & Owner Portal Webhook Endpoints
# ------------------------------------------------------------------------------
# Google Apps Script Webhook URLs for automatic sync
GOOGLE_SHEET_WEBHOOK_URL_1=https://script.google.com/macros/s/YOUR_SCRIPT_ID_1/exec
GOOGLE_SHEET_WEBHOOK_URL_2=https://script.google.com/macros/s/YOUR_SCRIPT_ID_2/exec
